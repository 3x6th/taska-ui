{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "taska-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "taska-ui-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_TASKA_API_MODE=mock VITE_TASKA_API_PROXY_TARGET= VITE_TASKA_MCP_URL=http://localhost:8087/mcp npm run dev -- --port 5191 --strictPort"
      ],
      "port": 5191
    },
    {
      "name": "taska-ui-rest-offline",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_TASKA_API_MODE=rest VITE_TASKA_API_PROXY_TARGET= npm run dev -- --port 5192 --strictPort"
      ],
      "port": 5192
    }
  ]
}
