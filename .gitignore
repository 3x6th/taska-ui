# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Node / frontend
node_modules/
dist/
coverage/
.vite/

# Playwright working output
test-results/
playwright-report/

# Local env
.env
.env.local
.env.*.local

# OS / IDE
.DS_Store

# Third-party skills, vendored on disk but restorable from skills-lock.json the
# same way node_modules is restorable from package-lock.json. They are upstream
# tooling, not this project's source, and do not belong in its history.
/.agents/skills/

# Machine-local permission allowlist, not project configuration.
.claude/settings.local.json

# Agent worktrees are scratch checkouts of this same repository.
.claude/worktrees/

# Agent working material: screenshots and full review verdicts stay local.
# Verdict summaries go to Jira comments; the repo carries only operational docs.
docs/ai/evidence/
docs/ai/reviews/
