# mock | rest | hybrid (hybrid is a pass-through to the gateway since TAS-224; TAS-209 removes it)
VITE_TASKA_API_MODE=hybrid
# Dev: keep /api/v1 (Vite proxies it to the gateway, see VITE_TASKA_API_PROXY_TARGET).
# Prod on taska.ozero.dev: set https://api.taska.ozero.dev/api/v1
VITE_TASKA_API_BASE_URL=/api/v1
VITE_TASKA_API_PROXY_TARGET=https://api.taska.ozero.dev
VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
VITE_SITE_URL=http://localhost:5173/

# Agent harness only — never read by the app, never bundled.
# Refero MCP (.mcp.json) is reachable by the art-director subagent for design
# references. Without it that agent simply has no reference tools; nothing else
# breaks. Keep the value in .env, never in .mcp.json.
REFERO_API_KEY=
